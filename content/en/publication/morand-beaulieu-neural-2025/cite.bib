@article{morand-beaulieu_neural_2025,
 abstract = {Depression is transmitted within families, but the mechanisms involved in such transmission are not clearly defined. A potential marker of familial risk is the neural response to errors, which may play a role in depression symptoms and is known to be partially heritable. Here, 97 mother-daughter dyads completed a Flanker task while electroencephalography markers of error monitoring were recorded: the error-related negativity (ERN) and response-locked delta and theta power. We assessed whether these measures of neural response to errors 1) were associated with history of recurrent major depressive disorder (MDD) and current depression symptoms among mothers, 2) were correlated among mother-daughter dyads, and 3) were associated with maternal history of recurrent MDD and maternal symptoms of depression among daughters. A history of recurrent MDD was associated with blunted delta and increased theta among mothers. Across mothers, delta and theta were negatively and positively associated, respectively, with current depression symptoms. Mothers' and daughters' ERN were positively correlated. Finally, current maternal depression symptoms were negatively associated with delta power in daughters. These results suggest that neural responses to errors may be implicated in the intergenerational transmission of depression. These results also support the relevance of delta oscillations to understanding pathways to depression.},
 author = {Morand-Beaulieu, S. and Banica, I. and Freeman, C. and Ethridge, P. and Sandre, A. and Weinberg, A.},
 doi = {10.1017/s0954579424001780},
 issn = {1469-2198 (Electronic) 0954-5794 (Linking)},
 journal = {Dev Psychopathol},
 keywords = {Evoked Potentials/physiology, Humans, Electroencephalography, Adult, Female, Middle Aged, Adolescent, Young Adult, event-related potentials, Delta Rhythm/physiology, depression, intergenerational transmission, Major Depressive Disorder/physiopathology/psychology, Mother-Child Relations, mother-daughter dyads, Mothers/psychology, Nuclear Family/psychology, Recurrence, Theta Rhythm/physiology, time-frequency analyses},
 language = {eng},
 month = {October},
 number = {4},
 pages = {2181--2195},
 title = {Neural response to errors among mothers with a history of recurrent depression and their adolescent daughters},
 volume = {37},
 year = {2025}
}

